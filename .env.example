# Copy to .env and replace these values locally; do not commit .env.
POSTGRES_PASSWORD=replace-with-a-unique-local-password
APP_SECRET=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql+psycopg://shopnex:replace-with-a-unique-local-password@127.0.0.1:5432/shopnex

# Local API stays on the host so it can use the operating-system credential vault.
CORS_ORIGINS=http://127.0.0.1:1420,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
