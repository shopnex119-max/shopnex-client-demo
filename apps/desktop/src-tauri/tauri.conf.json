{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHOPNEX ULTIMATE",
  "version": "0.7.1",
  "identifier": "com.shopnex.ultimate",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SHOPNEX ULTIMATE",
        "width": 1440,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8000; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../../services/api/dist/SHOPNEX-API": "api"
    },
    "shortDescription": "Local-first business operations platform",
    "longDescription": "SHOPNEX is a modular local-first ERP, point-of-sale and e-invoicing operations platform."
  }
}
